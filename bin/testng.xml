<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="All Tests Suite" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="utils.RetryTransformer"/>
        <listener class-name="report.ExtentTestNGListener"/>
    </listeners>
    <test name="API and Unit Tests">
        <packages>
            <package name="com.qa.automation" />
            <package name="tests" />
        </packages>
    </test>
</suite>